HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Mailchimp
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_LIST_ID=
MAILCHIMP_FROM_NAME="Mining Discovery"
MAILCHIMP_REPLY_TO="noreply@miningdiscovery.com"
FRONTEND_URL="https://www.miningdiscovery.com"
STRAPI_URL="http://localhost:1337"

# Media uploads on S3 (leave AWS_BUCKET empty to keep uploads on local disk).
# No access keys needed on EC2: the instance's IAM role is used.
AWS_REGION=ap-south-1
AWS_BUCKET=
# Public base URL for uploaded files (S3 endpoint now; CloudFront/custom domain later)
CDN_URL=https://miningdiscovery-media.s3.ap-south-1.amazonaws.com
